# URL del Google Apps Script deployado como Web App
# Ver gas/README.md para instrucciones de cómo obtener esta URL
NEXT_PUBLIC_GAS_URL=https://script.google.com/macros/s/TU_SCRIPT_ID_AQUI/exec

# URL de la Web App del módulo de Recibos (Apps Script deployado aparte).
# Habilita el botón "Generar recibo" en la lista de facturas: abre el recibo
# con el N° de factura ya cargado (?factura=<nro>). Sin esta variable, el botón
# avisa que falta configurarla.
NEXT_PUBLIC_RECIBOS_URL=https://script.google.com/macros/s/TU_RECIBOS_SCRIPT_ID_AQUI/exec

# URL del backend v2 (Code.v2.gs) desplegado como Web App, que lee la PLANILLA
# MAESTRA (modelo casoId). Lo usan las vistas ya migradas (Cobranza, y las que
# sigan). Si no se setea, el cliente usa el valor por defecto en gasClientV2.js.
NEXT_PUBLIC_GAS_V2_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_V2_AQUI/exec
